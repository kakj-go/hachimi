# Keep deterministic generators and Prettier checks independent of the Windows
# runner's global core.autocrlf setting.
* text=auto eol=lf

# Every packaged model file is checksum-verified. Disable text normalization so
# Windows and Unix checkouts preserve identical bytes.
apps/desktop/src-tauri/resources/ai-models/** -text

# Large, redistributable runtime assets. Git LFS must be installed before clone.
apps/desktop/src-tauri/resources/ai-models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
apps/desktop/src-tauri/resources/ai-models/**/voices.bin filter=lfs diff=lfs merge=lfs -text

# The redistributable, non-commercial default VRM is versioned through LFS so
# a normal clone followed by `git lfs pull` contains every packaging resource.
assets/avatar-default/**/*.vrm filter=lfs diff=lfs merge=lfs -text
