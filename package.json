{
  "name": "hachimi",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.10.0 <25",
    "pnpm": ">=11.15.0 <12"
  },
  "scripts": {
    "dev": "node scripts/run-with-rust.mjs tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "build": "node scripts/run-with-rust.mjs tauri build --debug --no-bundle --config apps/desktop/src-tauri/tauri.conf.json",
    "build:debug": "node scripts/run-with-rust.mjs tauri build --debug --no-bundle --config apps/desktop/src-tauri/tauri.conf.json",
    "build:installer": "node scripts/release/build-installers.mjs",
    "build:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "format": "prettier --write . && node scripts/run-with-rust.mjs cargo fmt --all",
    "format:check:prettier": "prettier --check .",
    "format:check:rust": "node scripts/run-with-rust.mjs cargo fmt --all --check",
    "format:check": "corepack pnpm format:check:prettier && corepack pnpm format:check:rust",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:clippy": "node scripts/run-with-rust.mjs cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "lint": "corepack pnpm lint:eslint && corepack pnpm lint:clippy",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test:packages": "corepack pnpm -r --if-present test",
    "test:node": "node --test scripts/desktop-e2e/support/*.test.mjs scripts/release/*.test.mjs",
    "test:rust": "node scripts/run-with-rust.mjs cargo test --workspace",
    "test": "corepack pnpm test:packages && corepack pnpm test:node && corepack pnpm test:rust",
    "test:desktop:e2e:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-desktop-e2e-tools.ps1",
    "test:desktop:e2e": "corepack pnpm test:desktop:e2e:prepare && node scripts/desktop-e2e/run.mjs",
    "test:desktop:stress": "node scripts/desktop-stress/run.mjs",
    "sidecars:prepare": "node scripts/prepare-workspace-worker.mjs dev",
    "cef:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-cef-host.ps1 -Release",
    "check:prepare": "corepack pnpm sidecars:prepare && corepack pnpm runtime:prepare && corepack pnpm cef:prepare",
    "test:p0-adversarial": "node scripts/test-p0-adversarial.mjs",
    "test:windows:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-release.ps1",
    "test:windows:standard-user": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-standard-user.ps1",
    "test:staging:openai": "node scripts/release/run-staging-gate.mjs openai",
    "test:staging:forge": "node scripts/release/run-staging-gate.mjs forge",
    "test:staging:enterprise": "node scripts/release/run-staging-gate.mjs enterprise",
    "test:staging:channels": "node scripts/release/run-staging-gate.mjs channels",
    "test:staging": "corepack pnpm test:staging:openai && corepack pnpm test:staging:forge && corepack pnpm test:staging:enterprise && corepack pnpm test:staging:channels",
    "release:check-clean": "node scripts/check-clean-worktree.mjs",
    "release:version-check": "node scripts/release/version-check.mjs",
    "release:artifact-manifest": "node scripts/release/create-artifact-manifest.mjs",
    "release:artifact-verify": "node scripts/release/verify-candidate-artifacts.mjs",
    "release:evidence:verify": "node scripts/release/verify-evidence.mjs",
    "release:source-summary": "node scripts/release/create-source-summary.mjs",
    "storybook": "corepack pnpm --filter @hachimi/ui storybook",
    "storybook:build": "corepack pnpm --filter @hachimi/ui storybook:build",
    "test:visual": "corepack pnpm --filter @hachimi/ui test:visual",
    "contracts:generate": "node scripts/run-with-rust.mjs cargo run -p hachimi-protocol --bin export-types -- packages/contracts/src/generated.ts",
    "contracts:check": "node scripts/run-with-rust.mjs cargo run -p hachimi-protocol --bin export-types -- packages/contracts/src/generated.ts --check",
    "architecture:check": "node scripts/check-agent-architecture.mjs",
    "provenance:check": "node scripts/check-harness-provenance.mjs && node scripts/check-agent-architecture.mjs",
    "models:prepare": "node scripts/ensure-speech-models.mjs",
    "runtime:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-managed-git.ps1",
    "motions:sync": "node scripts/sync-avatar-motions-v4.mjs",
    "motions:check": "node scripts/sync-avatar-motions-v4.mjs --check",
    "check": "corepack pnpm check:prepare && corepack pnpm format:check && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm contracts:check && corepack pnpm provenance:check && corepack pnpm test:p0-adversarial && corepack pnpm storybook:build && corepack pnpm test:visual && corepack pnpm build && corepack pnpm test:desktop:e2e",
    "tauri": "node scripts/run-with-rust.mjs tauri"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tauri-apps/cli": "2.11.4",
    "@wdio/cli": "9.30.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/spec-reporter": "9.29.1",
    "eslint": "9.39.2",
    "eslint-plugin-solid": "0.14.5",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.52.0",
    "webdriverio": "9.30.0"
  }
}
