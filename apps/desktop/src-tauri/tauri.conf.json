{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hachimi",
  "version": "1.0.0",
  "identifier": "com.hachimi.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-workspace-worker.mjs dev && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-managed-git.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-cef-host.ps1 && corepack pnpm --dir apps/desktop/web dev",
    "beforeBuildCommand": "node scripts/ensure-speech-models.mjs && node scripts/prepare-workspace-worker.mjs both && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-managed-git.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-cef-host.ps1 -Release && corepack pnpm --dir apps/desktop/web build",
    "devUrl": "http://localhost:1420/pet.html",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "create": false,
        "url": "pet.html",
        "title": "Hachimi",
        "width": 360,
        "height": 480,
        "minWidth": 360,
        "minHeight": 480,
        "maxWidth": 360,
        "maxHeight": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://hachimi-avatar.localhost hachimi-avatar: http://hachimi-motion.localhost hachimi-motion:; img-src 'self' data: blob: http://hachimi-avatar.localhost hachimi-avatar:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; frame-src hachimi-plugin-ui: http://hachimi-plugin-ui.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "resources/internal-runtime/": "internal-runtime/",
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE.md": "NOTICE.md",
      "../../../assets/avatar-default/2639776812528692620/2639776812528692620.vrm": "resources/avatar-default/2639776812528692620/2639776812528692620.vrm",
      "../../../assets/avatar-default/2639776812528692620/manifest.json": "resources/avatar-default/2639776812528692620/manifest.json",
      "../../../assets/avatar-default/2639776812528692620/NOTICE.md": "resources/avatar-default/2639776812528692620/NOTICE.md",
      "../../../assets/avatar-motions-v4/": "resources/avatar-motions-v4/",
      "resources/skills/builtin/": "resources/skills/builtin/",
      "resources/ai-models/THIRD-PARTY-NOTICES.md": "resources/ai-models/THIRD-PARTY-NOTICES.md",
      "resources/ai-models/speech-to-text/": "resources/ai-models/speech-to-text/",
      "resources/ai-models/text-to-speech/": "resources/ai-models/text-to-speech/",
      "managed-git/": "managed-git/",
      "../../../target/cef-bundle/": "cef-runtime/",
      "../../../assets/browser-extension/": "browser-extension/",
      "../../../assets/plugins/sample-crm/": "plugins/sample-crm/",
      "../../../assets/plugins/wecom_app/": "plugins/wecom_app/",
      "../../../assets/plugins/wecom_ai_bot/": "plugins/wecom_ai_bot/",
      "../../../assets/plugins/wechat_ilink/": "plugins/wechat_ilink/",
      "../../../assets/plugins/dingtalk/": "plugins/dingtalk/",
      "../../../assets/plugins/feishu/": "plugins/feishu/",
      "resources/native/sherpa-onnx-1.13.4-directml/windows-x64/DirectML.dll": "DirectML.dll",
      "resources/native/sherpa-onnx-1.13.4-directml/windows-x64/onnxruntime.dll": "onnxruntime.dll",
      "resources/native/sherpa-onnx-1.13.4-directml/windows-x64/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
